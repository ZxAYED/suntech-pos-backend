# Runtime mode: development, test, or production.
NODE_ENV=development

# PostgreSQL connection string used by Prisma.
# Matches the credentials in docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/suntech_pos?schema=public"

# API port. The Next.js frontend is expected on port 3000.
PORT=3001

# Browser origin allowed by CORS.
FRONTEND_URL="http://localhost:3000"

# Auth. Generate secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d
OTP_TTL_MINUTES=15

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Super Admin Bootstrap (Required for automated Super Admin initialization)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# One-time initialization ONLY; leave false for normal server restarts.
RUN_BOOTSTRAP_SEED=false


# Optional, paired store Admin bootstrap; do not use legacy ADMIN_EMAIL fallbacks.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=

# Offline synchronization clock-skew tolerance in seconds (default 300 = 5 minutes).
OFFLINE_MAX_FUTURE_SKEW_SECONDS=300

# Local-first checkout v2. Generate a private EC P-256 key using
# node scripts/generate-offline-signing-key.cjs /private/path/offline-key.env
# Keep the resulting file secret. The browser receives ONLY the public key.
OFFLINE_SIGNING_PRIVATE_KEY_BASE64=

# Blank or zero means: ONLINE-ONLY credentials, valid for 300 seconds.
# Set a positive number ONLY after approving how long new offline selling is allowed.
# This is a permission duration, NOT a sale-count cap or an event-retention period.
OFFLINE_GRANT_TTL_SECONDS=

# Default false preserves current-price checking. Enable captured historical prices
# only after the business approves the policy. Already saved events are never repriced.
OFFLINE_CAPTURED_PRICE_ENABLED=false

# REVIEW preserves a closed/invalid shift disagreement for review.
# DETACH_WITH_WARNING records an approved deferred sale without reopening the old shift.
OFFLINE_CLOSED_SHIFT_POLICY=REVIEW

# Setting false stops issuance of NEW permissions. Existing saved events can still sync.
OFFLINE_NEW_INTAKE_ENABLED=true

# During signing-key rotation, retain old public keys for old queued events.
# JSON array: [{"kid":"previous-key-id","jwk":{"kty":"EC","crv":"P-256","x":"...","y":"..."}}]
OFFLINE_VERIFICATION_KEYS_JSON=[]


# STAGING ONLY: require written store approval and device qualification.
OFFLINE_REFUND_PAYOUT_EVIDENCE_ENABLED=false
OFFLINE_PRODUCT_DESCRIPTION_ENABLED=false
