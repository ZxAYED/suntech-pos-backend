enum AdvanceStatus {
  PENDING
  DEDUCTED
}

enum PayrollStatus {
  DUE
  PAID
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model EmployeeAdvance {
  id         String        @id @default(uuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cashierId  String
  cashier    User          @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  shiftId    String?
  shift      ShiftSession? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  locationId String?
  location   Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)

  amount         Int
  deductedAmount Int           @default(0)
  takenAt        DateTime      @default(now())
  reason         String?
  status         AdvanceStatus @default(PENDING)

  expense           Expense?
  payrollDeductions PayrollAdvanceDeduction[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([businessId])
  @@index([cashierId])
  @@index([shiftId])
  @@index([locationId])
}

model PayrollRecord {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cashierId  String
  cashier    User     @relation(fields: [cashierId], references: [id])

  month Int
  year  Int

  baseSalary            Int
  totalAdvancesDeducted Int
  netPaid               Int
  status                PayrollStatus @default(PAID)

  advanceDeductions PayrollAdvanceDeduction[]
  expense           Expense?

  createdAt DateTime @default(now())

  @@unique([cashierId, month, year])
  @@index([businessId])
}

model PayrollAdvanceDeduction {
  id        String          @id @default(uuid())
  payrollId String
  payroll   PayrollRecord   @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  advanceId String
  advance   EmployeeAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime        @default(now())

  @@index([payrollId])
  @@index([advanceId])
}

model ShiftSession {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  cashierId  String
  cashier    User     @relation(fields: [cashierId], references: [id])

  startingAmount Int
  closingAmount  Int?
  expectedAmount Int?
  variance       Int?
  cashSales      Int         @default(0)
  advancesOut    Int         @default(0)
  cashCollected  Int         @default(0)
  status         ShiftStatus @default(OPEN)
  notes          String?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  orders   Order[]
  advances EmployeeAdvance[]
  refunds  Refund[]          @relation("ShiftRefunds")

  @@index([businessId])
  @@index([locationId])
  @@index([cashierId, status])
}
