model Business {
  id                   String  @id @default(uuid())
  name                 String
  ownerId              String  @unique
  profileImageUrl      String?
  profileImagePublicId String?
  owner                User    @relation("BusinessOwner", fields: [ownerId], references: [id])

  locations  Location[]
  users      User[]            @relation("BusinessStaff")
  categories Category[]
  products   Product[]
  variants   Variant[]
  advances   EmployeeAdvance[]
  shifts     ShiftSession[]
  payroll    PayrollRecord[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Location {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  address    String?

  users  User[]         @relation("LocationStaff")
  shifts ShiftSession[]
  orders Order[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String
  scopeId      String
  path         String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([scopeId, key])
  @@index([expiresAt])
}
