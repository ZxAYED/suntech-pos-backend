enum PaymentMethod {
  COD
  BKASH
  NAGAD
  BANK
}

enum OrderType {
  CATALOG
  CUSTOM
}

enum OrderStatus {
  PAID
  PENDING
  REFUNDED
}

enum StockTransactionType {
  SALE
  REFUND
  RESTOCK
  MANUAL_ADJUSTMENT
}

model Category {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  slug        String?
  description String?
  isActive    Boolean   @default(true)
  products    Product[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([businessId, name])
  @@unique([businessId, slug])
  @@index([businessId])
}

model Product {
  id               String    @id @default(uuid())
  businessId       String
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants         Variant[]
  isActive         Boolean   @default(true)
  customAttributes Json?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
}

model Variant {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String
  barcode    String?

  sellingPrice     Int
  costPrice        Int?
  stock            Int     @default(0)
  isActive         Boolean @default(true)
  customAttributes Json?

  profileImageUrl      String?
  profileImagePublicId String?
  profileImageKey      String?

  orderLines        OrderLine[]
  stockTransactions StockTransaction[]
  images            VariantImage[]
  locationStocks    LocationStock[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
}

model VariantImage {
  id        String   @id @default(uuid())
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  publicId  String   @unique
  key       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([variantId])
}

model Order {
  id                  String        @id @default(uuid())
  invoiceNumber       String        @unique
  receiptNumber       String?       @unique
  clientOrderId       String?       @unique
  clientReceiptNumber String?
  deviceId            String?
  orderType           OrderType     @default(CATALOG)
  status              OrderStatus   @default(PAID)
  locationId          String
  location            Location      @relation(fields: [locationId], references: [id])
  shiftId             String?
  shift               ShiftSession? @relation(fields: [shiftId], references: [id])
  cashierId           String
  cashier             User          @relation("CashierOrders", fields: [cashierId], references: [id])

  subtotal       Int
  totalAmount    Int
  tenderedAmount Int
  changeDue      Int

  customerName   String?
  customerPhone  String?
  customerNumber String?
  notes          String?

  paymentMethod PaymentMethod @default(COD)

  lines   OrderLine[]
  refunds Refund[]

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([locationId])
  @@index([shiftId])
  @@index([cashierId])
  @@index([orderType])
  @@index([status])
  @@index([occurredAt])
  @@index([createdAt])
}

model OrderLine {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName  String
  variantName  String?
  quantity     Int
  unitPrice    Int
  unitCost     Int?
  subtotal     Int
  categoryName String?

  refundItems RefundItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([variantId])
}

model Refund {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  processedById String
  processedBy   User          @relation("RefundAuditor", fields: [processedById], references: [id])
  payoutShiftId String?
  payoutShift   ShiftSession? @relation("ShiftRefunds", fields: [payoutShiftId], references: [id], onDelete: SetNull)

  totalRefund Int
  reason      String?
  items       RefundItem[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([processedById])
  @@index([payoutShiftId])
}

model RefundItem {
  id          String    @id @default(uuid())
  refundId    String
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderLineId String
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  quantity     Int
  refundAmount Int

  createdAt DateTime @default(now())

  @@index([refundId])
  @@index([orderLineId])
}

model StockTransaction {
  id         String               @id @default(uuid())
  variantId  String
  variant    Variant              @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId String?
  type       StockTransactionType
  quantity   Int
  notes      String?
  createdAt  DateTime             @default(now())
}

model LocationStock {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stock      Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([locationId, variantId])
  @@index([businessId])
  @@index([locationId])
  @@index([variantId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  businessId String?
  locationId String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([locationId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  SUPPLIES
  MAINTENANCE
  MARKETING
  TRANSPORT
  INVENTORY
  PERSONAL_DRAWING
  OTHER
}

model Expense {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  userId     String
  user       User      @relation("UserExpenses", fields: [userId], references: [id], onDelete: Cascade)

  amount   Int
  title    String
  category ExpenseCategory @default(OTHER)
  note     String?
  spentAt  DateTime        @default(now())

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([businessId])
  @@index([locationId])
  @@index([userId])
  @@index([spentAt])
  @@index([deletedAt])
}
